<archetype-descriptor
        xmlns="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.2.0"
        name="quickstart">

    <requiredProperties>
        <requiredProperty key="groupId"/>
        <requiredProperty key="artifactId"/>
        <requiredProperty key="version">
            <defaultValue>0.0.1-SNAPSHOT</defaultValue>
        </requiredProperty>
        <requiredProperty key="package"/>
    </requiredProperties>

    <fileSets>
        <!-- ===================== JAVA MAIN ===================== -->
        <fileSet filtered="true">
            <directory>backend/api/src/main/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/application/src/main/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/bootstrap/src/main/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/domain/src/main/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/external/src/main/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/transport/src/main/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>

        <!-- ===================== JAVA TEST ===================== -->
        <fileSet filtered="true">
            <directory>backend/api/src/test/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/application/src/test/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/bootstrap/src/test/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/domain/src/test/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/external/src/test/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/transport/src/test/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>

        <!-- ===================== RESOURCES ===================== -->
        <fileSet filtered="true">
            <directory>backend</directory>
            <includes>
                <include>*/src/main/resources/**</include>
                <include>*/src/test/resources/**</include>
                <include>*/src/**/.gitkeep</include>
            </includes>
        </fileSet>

        <!-- ===================== POMs & DOTFILES ===================== -->
        <fileSet filtered="true">
            <directory>backend</directory>
            <includes>
                <include>pom.xml</include>
                <include>*/pom.xml</include>
                <include>**/*.md</include>
                <include>**/.gitignore</include>
                <include>**/.gitkeep</include>
            </includes>
        </fileSet>

        <!-- ===================== SONAR ===================== -->
        <fileSet filtered="true" packaged="false">
            <directory>backend</directory>
            <includes>
                <include>sonar-project.yml</include>
            </includes>
        </fileSet>

        <!-- ===================== Dockerfile ===================== -->
        <fileSet filtered="true" packaged="false">
            <directory>backend</directory>
            <includes>
                <include>Dockerfile</include>
            </includes>
        </fileSet>

        <!-- ===================== DOCS ===================== -->
        <fileSet>
            <directory>docs</directory>
            <includes>
                <include>**/*</include>
                <include>**/.*</include>
            </includes>
        </fileSet>

        <!-- ===================== HTTP ===================== -->
        <fileSet>
            <directory>http</directory>
            <includes>
                <include>**/*</include>
                <include>**/.*</include>
            </includes>
        </fileSet>

        <!-- ===================== GENERATED PROJECT ROOT ===================== -->
        <fileSet filtered="false" packaged="false">
            <directory>project-root</directory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>


    </fileSets>
</archetype-descriptor>
