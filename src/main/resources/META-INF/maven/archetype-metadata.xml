<archetype-descriptor
        xmlns="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.2.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
      https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.2.0
      https://maven.apache.org/xsd/archetype-descriptor-1.2.0.xsd"
        name="quickstart">

    <requiredProperties>
        <requiredProperty key="groupId"/>
        <requiredProperty key="artifactId"/>
        <requiredProperty key="version">
            <defaultValue>0.0.1-SNAPSHOT</defaultValue>
        </requiredProperty>
        <requiredProperty key="package">
            <defaultValue>com.example</defaultValue>
        </requiredProperty>
    </requiredProperties>

    <fileSets>
        <!-- ===================== JAVA MAIN ===================== -->
        <fileSet filtered="true">
            <directory>backend/entrypoint/src/main/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/application/src/main/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/bootstrap/src/main/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/domain/src/main/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/external/src/main/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/presentation/src/main/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>

        <!-- ===================== JAVA TEST ===================== -->
        <fileSet filtered="true">
            <directory>backend/entrypoint/src/test/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/application/src/test/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/bootstrap/src/test/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/domain/src/test/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/external/src/test/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>
        <fileSet filtered="true">
            <directory>backend/presentation/src/test/java</directory>
            <includes><include>__packageInPathFormat__/**</include></includes>
        </fileSet>

        <!-- ===================== RESOURCES ===================== -->
        <fileSet filtered="true">
            <directory>backend</directory>
            <includes>
                <include>*/src/main/resources/**</include>
                <include>*/src/test/resources/**</include>
                <include>*/src/**/.gitkeep</include>
            </includes>
        </fileSet>

        <!-- ===================== POMs & DOTFILES ===================== -->
        <fileSet filtered="true">
            <directory>backend</directory>
            <includes>
                <include>pom.xml</include>
                <include>*/pom.xml</include>
                <include>**/*.md</include>
                <include>**/.gitignore</include>
                <include>**/.gitkeep</include>
            </includes>
        </fileSet>

        <!-- ===================== DOCS ===================== -->
        <fileSet>
            <directory>docs</directory>
            <includes>
                <include>**/*</include>
                <include>**/.*</include>
            </includes>
        </fileSet>

        <!-- ===================== HTTP ===================== -->
        <fileSet>
            <directory>http</directory>
            <includes>
                <include>**/*</include>
                <include>**/.*</include>
            </includes>
        </fileSet>

        <!-- ===================== GENERATED PROJECT ROOT ===================== -->
        <fileSet filtered="true">
            <directory>.</directory>
            <includes>
                <include>pom.xml</include>
                <include>README.md</include>
                <include>.gitignore</include>
            </includes>
        </fileSet>

    </fileSets>
</archetype-descriptor>
