######################################################################
#   CREATE EXAMPLE — OK (201)
######################################################################

### Create example (English)
POST {{baseUrl}}/api/examples
Content-Type: application/json
Accept: application/json
Accept-Language: en

{
  "name": "My first example"
}

### Create example (French)
POST {{baseUrl}}/api/examples
Content-Type: application/json
Accept: application/json
Accept-Language: fr

{
  "name": "Mon premier exemple"
}


######################################################################
#   ERROR CASES TO TEST
######################################################################

### Validation — missing / blank name → 400
POST {{baseUrl}}/api/examples
Content-Type: application/json
Accept: application/json
Accept-Language: en

{
  "name": ""
}

### Validation — missing / blank name (French) → 400
POST {{baseUrl}}/api/examples
Content-Type: application/json
Accept: application/json
Accept-Language: fr

{
  "name": ""
}


### Validation — name too short (<3) → 400
POST {{baseUrl}}/api/examples
Content-Type: application/json
Accept: application/json
Accept-Language: en

{
  "name": "ab"
}

### Validation — name too short (<3) (French) → 400
POST {{baseUrl}}/api/examples
Content-Type: application/json
Accept: application/json
Accept-Language: fr

{
  "name": "ab"
}


######################################################################
#   BUSINESS ERRORS
######################################################################

### Business — duplicate (ALREADY_EXISTS) → 409
POST {{baseUrl}}/api/examples
Content-Type: application/json
Accept: application/json
Accept-Language: en

{
  "name": "duplicate"
}

### Business — duplicate (ALREADY_EXISTS) (French) → 409
POST {{baseUrl}}/api/examples
Content-Type: application/json
Accept: application/json
Accept-Language: fr

{
  "name": "duplicate"
}

### Business — forbidden name (FORBIDDEN) → 403
POST {{baseUrl}}/api/examples
Content-Type: application/json
Accept: application/json
Accept-Language: en

{
  "name": "forbidden"
}

### Business — forbidden name (FORBIDDEN) (French) → 403
POST {{baseUrl}}/api/examples
Content-Type: application/json
Accept: application/json
Accept-Language: fr

{
  "name": "forbidden"
}
